{
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1500,
  "workbench.editorAssociations": {
    "*.md": "cweijan.markdownViewer",
    "*.markdown": "cweijan.markdownViewer"
  },
  "vscode-office.enableTelemetry": false,
  "vscode-office.editMode": "wysiwyg",
  "vscode-office.editorTheme": "Warm Light",
  "editor.fontSize": 17,
  "editor.lineHeight": 1.7,
  "editor.wordWrap": "on",
  "editor.minimap.enabled": false,
  "editor.glyphMargin": false,
  "breadcrumbs.enabled": false,
  "workbench.startupEditor": "none",
  "explorer.compactFolders": false,
  "markdown.preview.fontSize": 17,
  "markdown.preview.lineHeight": 1.7,
  "workbench.editor.customLabels.enabled": true,
  "workbench.editor.customLabels.patterns": {
    "**/current manuscript/_may-reference*.md": "OLDER · May check",
    "**/current manuscript/[0-9][0-9]-*.md": "YOUR BOOK · ${filename}",
    "**/current manuscript/00-*.md": "YOUR BOOK · ${filename}"
  }
}
